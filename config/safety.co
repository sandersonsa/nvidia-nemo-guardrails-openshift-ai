# Fluxo que intercepta a pergunta do usuário
define flow verificar seguranca da entrada
  $is_safe = execute check_jailbreak_and_toxicity
  
  if not $is_safe
    bot recusa responder
    stop

# Fluxo que intercepta a resposta gerada pelo LLM principal
define flow verificar seguranca da resposta
  $is_output_safe = execute check_response_toxicity
  
  if not $is_output_safe
    bot resposta alterada por seguranca
    stop

# Mensagens de fallback customizadas em PT-BR
define bot recusa responder
  "Desculpe, mas não posso responder a essa solicitação pois ela viola as nossas diretrizes de segurança."

define bot resposta alterada por seguranca
  "A resposta gerada violou nossas políticas internas de segurança. Como posso te ajudar com outro assunto?"
